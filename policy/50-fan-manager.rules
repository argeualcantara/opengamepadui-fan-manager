// Installs to /etc/polkit-1/rules.d/. Grants the active local
// graphical session's own user permission to start (and only start)
// instances of the fan-manager-priv-write@.service template unit
// (see that file and fan-manager-priv-write's own header comment for
// why this exists instead of a plain pkexec call), without a
// password prompt.
//
// Same pattern already used by this OS image itself for uupd
// (/etc/polkit-1/rules.d/uupd.rules), matching on
// org.freedesktop.systemd1.manage-units + a specific unit name —
// generalized here to a regex since fan-manager-priv-write@ is a
// template with a different instance string per write, not a single
// fixed unit name.
//
// allow_active-equivalent (subject.active): fan curve writes happen
// continuously while polling (CustomCurveEngine's poll timer), not as
// a one-off user action, so prompting per-write isn't viable — same
// trust model already used by this device family for TDP/GPU clock
// controls (frequent writes, local physically-present user, no
// remote/multi-user scenario to protect against).
//
// The actual safety boundary is NOT this file: it's
// fan-manager-priv-write's own path whitelist and per-attribute value
// validation, run every time regardless of how it got invoked. This
// file only controls WHO may start the unit, not what the unit is
// allowed to do once started.

polkit.addRule(function(action, subject) {
	if (action.id != "org.freedesktop.systemd1.manage-units") {
		return polkit.Result.NOT_HANDLED;
	}

	var unit = action.lookup("unit");
	var verb = action.lookup("verb");

	if (!/^fan-manager-priv-write@[^/]+\.service$/.test(unit)) {
		return polkit.Result.NOT_HANDLED;
	}
	if (verb && verb != "start") {
		return polkit.Result.NOT_HANDLED;
	}

	if (subject.active && subject.local && subject.isInGroup("wheel")) {
		return polkit.Result.YES;
	}

	return polkit.Result.NOT_HANDLED;
});
